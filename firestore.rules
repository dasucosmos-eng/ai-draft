rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users: root document ───
    match /users/{uid} {
      // Root user document (e.g. profile stored at top level)
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // ─── Sub-collection: users/{uid}/data/{docId} ───
      match /data/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // ─── Sub-collection: users/{uid}/app/{docId} ───
      // This is the main data document used by the sync-layer:
      //   doc(db, 'users', uid, 'app', 'data')
      // The Firestore path is: users/{uid}/app (collection) → data (document)
      match /app/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ─── Usage tracking (written by Cloud Functions, read by users) ───
    match /usage/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // ─── Phone OTP collection (legacy — can be removed after migration) ───
    match /phone_otps/{docId} {
      allow read, write: if false;
    }

    // ─── OAuth states collection (legacy — can be removed after migration) ───
    match /oauth_states/{docId} {
      allow read, write: if false;
    }

    // ─── Deny all other paths by default ───
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
